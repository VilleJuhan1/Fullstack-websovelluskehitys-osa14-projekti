# Helm values configuration for kube-prometheus-stack
# Templated via Ansible monitoring role
# Designed for lightweight K3s clusters

prometheusOperator:
  enabled: true
  resources:
    limits:
      cpu: 200m
      memory: 256Mi
    requests:
      cpu: 50m
      memory: 128Mi

prometheus:
  enabled: true
  prometheusSpec:
    # Use PersistentVolume mapping to /mnt/data/prometheus
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: "manual"
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: 5Gi
    resources:
      limits:
        cpu: 500m
        memory: 512Mi
      requests:
        cpu: 100m
        memory: 256Mi
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false

grafana:
  enabled: true
  assertNoLeakedSecrets: false
  adminUser: "{{ grafana_admin_user | default(lookup('ansible.builtin.env', 'GRAFANA_ADMIN_USER'), true) | default('admin', true) }}"
  adminPassword: "{{ grafana_admin_password | default(lookup('ansible.builtin.env', 'GRAFANA_ADMIN_PASSWORD'), true) | default('admin', true) }}"
  additionalDataSources:
    - name: Loki
      type: loki
      access: proxy
      url: http://loki.monitoring.svc.cluster.local:3100
      jsonData:
        maxLines: 1000
  grafana.ini:
    server:
      root_url: https://grafana.hiekkalaatikko.tech
    auth:
      disable_login_form: true
    auth.github:
      enabled: true
      allow_sign_up: true
      client_id: "{{ grafana_github_client_id | default(lookup('ansible.builtin.env', 'GRAFANA_GITHUB_CLIENT_ID'), true) }}"
      client_secret: "{{ grafana_github_client_secret | default(lookup('ansible.builtin.env', 'GRAFANA_GITHUB_CLIENT_SECRET'), true) }}"
      scopes: user:email,read:org
      allowed_organizations: "{{ grafana_github_allowed_orgs | default('') }}"
      allowed_users: "{{ grafana_github_allowed_users | default('') }}"
  persistence:
    enabled: false
  sidecar:
    dashboards:
      enabled: true
      label: grafana_dashboard
      labelValue: "1"
      searchNamespace: monitoring
  ingress:
    enabled: true
    ingressClassName: nginx
    annotations:
      cert-manager.io/cluster-issuer: "letsencrypt-prod"
      nginx.ingress.kubernetes.io/ssl-redirect: "true"
    hosts:
      - grafana.hiekkalaatikko.tech
    path: /
    tls:
      - secretName: grafana-tls
        hosts:
          - grafana.hiekkalaatikko.tech
  resources:
    limits:
      cpu: 500m
      memory: 512Mi
    requests:
      cpu: 100m
      memory: 256Mi

alertmanager:
  enabled: false # Alertmanager can be disabled for basic monitoring to save resources

kubeStateMetrics:
  enabled: true
  resources:
    limits:
      cpu: 100m
      memory: 128Mi
    requests:
      cpu: 10m
      memory: 64Mi

nodeExporter:
  enabled: true
  resources:
    limits:
      cpu: 100m
      memory: 128Mi
    requests:
      cpu: 10m
      memory: 64Mi

# K3s specific optimizations (disable upstream control plane component scraping)
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeEtcd:
  enabled: false
kubeProxy:
  enabled: false

